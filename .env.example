# --- Groq (Llama) ---
GROQ_API_KEY=sua_chave_groq_aqui
# Opcional — troque se quiser usar outro modelo disponível na Groq
GROQ_MODEL=openai/gpt-oss-120b

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=seu_token_aqui
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui
# Token de verificação do webhook no painel da Meta
WHATSAPP_VERIFY_TOKEN=sua_frase_secreta_aqui

# --- Números internos dos setores (formato internacional, apenas dígitos: Ex 5592999999999) ---
NUMERO_PSICOLOGIA=
NUMERO_NUTRICAO=
NUMERO_HOSPITAL_DIA=
NUMERO_CENTRO_CIRURGICO=
NUMERO_OUVIDORIA=
NUMERO_RECEPCAO_GERAL=

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Ou DATABASE_URL completa (opcional):
# DATABASE_URL=mysql://usuario:senha@localhost:3306/banco

PORT=3000
